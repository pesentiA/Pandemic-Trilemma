# STOCK: below-the-line (persistent liquidity/solvency protection)
# Low-take-up baseline: loans 40%, guarantees 25%
F_CP_loans_stock = cumsum(replace_na(F_CP_loans_lo, 0)),
F_CP_guar_stock  = cumsum(replace_na(F_CP_guar_lo,  0)),
F_CP_belowstock  = F_CP_loans_stock + F_CP_guar_stock,
# Auxiliary alternative aggregations (for robustness)
F_CP_above_3_stock = cumsum(replace_na(F_CP_above_3, 0)),
F_CP_total_stock   = cumsum(replace_na(F_CP, 0)),
F_DI_stock         = cumsum(replace_na(F_DI, 0))
) |> ungroup()
colnames(df_bin)
##DESCRIPTIVES OF USED VFISCAL VARIABLES
# Alle Variablen, die wirklich mit grossem F beginnen
f_vars <- names(df_bin) %>%
stringr::str_subset("^F")
# Zusätzliche Variablen, falls du sie auch in der Tabelle willst
extra_vars <- c(
"CP_share",
"DI_share",
"n_measures_CP",
"n_measures_DI"
)
desc_vars <- c(f_vars, extra_vars)
desc_fiscal_vars <- df_bin %>%
select(any_of(desc_vars)) %>%
pivot_longer(
cols = everything(),
names_to = "variable",
values_to = "value"
) %>%
group_by(variable) %>%
summarise(
n_obs       = sum(!is.na(value)),
n_missing   = sum(is.na(value)),
sum         = sum(value, na.rm = TRUE),
mean        = mean(value, na.rm = TRUE),
median      = median(value, na.rm = TRUE),
sd          = sd(value, na.rm = TRUE),
min         = min(value, na.rm = TRUE),
p25         = quantile(value, 0.25, na.rm = TRUE),
p75         = quantile(value, 0.75, na.rm = TRUE),
p90         = quantile(value, 0.90, na.rm = TRUE),
p99         = quantile(value, 0.99, na.rm = TRUE),
max         = max(value, na.rm = TRUE),
n_zero      = sum(value == 0, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
pct_zero = round(n_zero / n_obs * 100, 1)
) %>%
arrange(variable)
cat("\n--- Descriptive Statistics: Fiscal Variables ---\n")
print(as.data.frame(desc_fiscal_vars))
# Alle Variablen, die mit F beginnen
f_vars <- names(df_bin)[grepl("^F", names(df_bin))]
# Zusätzliche Variablen
extra_vars <- c(
"CP_share",
"DI_share",
"H_share",
"n_measures_CP",
"n_measures_DI",
"n_measures_H"
)
desc_vars <- c(f_vars, extra_vars)
desc_fiscal_by_country <- df_bin %>%
select(Country, any_of(desc_vars)) %>%
pivot_longer(
cols = -Country,
names_to = "variable",
values_to = "value"
) %>%
group_by(Country, variable) %>%
summarise(
n_obs       = sum(!is.na(value)),
n_missing   = sum(is.na(value)),
sum         = sum(value, na.rm = TRUE),
mean        = mean(value, na.rm = TRUE),
median      = median(value, na.rm = TRUE),
sd          = sd(value, na.rm = TRUE),
min         = min(value, na.rm = TRUE),
p25         = quantile(value, 0.25, na.rm = TRUE),
p75         = quantile(value, 0.75, na.rm = TRUE),
p90         = quantile(value, 0.90, na.rm = TRUE),
p99         = quantile(value, 0.99, na.rm = TRUE),
max         = max(value, na.rm = TRUE),
n_zero      = sum(value == 0, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
pct_zero = round(n_zero / n_obs * 100, 1)
) %>%
arrange(Country, variable)
cat("\n--- Descriptive Statistics: Fiscal Variables by Country ---\n")
print(as.data.frame(desc_fiscal_by_country))
# Construct flow and stock variables
df_bin <- df_bin |>
group_by(Country) |> arrange(t_idx) |>
mutate(
# FLOW: above-the-line (acute, no persistence mechanism)
F_CP_above_flow      = F_CP_above_3,
F_CP_above_flow_lag1 = lag(F_CP_above_3, 1),
F_CP_above_flow_lag2 = lag(F_CP_above_3, 2),
# Auxiliary lags for robustness
F_H_lag2 = lag(F_H, 2),
y_lag2   = lag(y_t_pct, 2),
# STOCK: below-the-line (persistent liquidity/solvency protection)
# Low-take-up baseline: loans 40%, guarantees 25%
F_CP_loans_stock = cumsum(replace_na(F_CP_loans_lo, 0)),
F_CP_guar_stock  = cumsum(replace_na(F_CP_guar_lo,  0)),
F_CP_belowstock  = F_CP_loans_stock + F_CP_guar_stock,
# Auxiliary alternative aggregations (for robustness)
F_CP_above_3_stock = cumsum(replace_na(F_CP_above_3, 0)),
F_CP_total_stock   = cumsum(replace_na(F_CP, 0)),
F_DI_stock         = cumsum(replace_na(F_DI, 0))
) |> ungroup()
colnames(df_bin)
# Fiscal-Kategorien ohne lags/leads/cumulative variants
f_category_vars <- names(df_bin) %>%
grep("^F", ., value = TRUE) %>%
grep("lag|lead|cum", ., value = TRUE, invert = TRUE)
fiscal_sums_by_country <- df_bin %>%
group_by(Country) %>%
summarise(
across(
all_of(f_category_vars),
~ sum(.x, na.rm = TRUE),
.names = "{.col}"
),
.groups = "drop"
) %>%
arrange(Country)
cat("\n--- Fiscal Sums by Country over Full Sample ---\n")
print(as.data.frame(fiscal_sums_by_country))
# Kontrolle: sollte 38 sein
nrow(fiscal_sums_by_country)
fiscal_vars <- c(
"F_CP",
"F_DI",
"F_H",
"F_CP_loans_mid",
"F_CP_guar_lo"
)
fiscal_sums_by_country <- df_bin %>%
group_by(Country) %>%
summarise(
across(
all_of(fiscal_vars),
~ sum(.x, na.rm = TRUE),
.names = "{.col}"
),
.groups = "drop"
) %>%
arrange(Country)
cat("\n--- Fiscal Sums by Country over Full Sample ---\n")
print(as.data.frame(fiscal_sums_by_country))
# Kontrolle: sollte 38 sein
nrow(fiscal_sums_by_country)
# Variablen definieren
fiscal_vars <- c(
"F_CP",
"F_DI",
"F_H",
"F_CP_loans_mid",
"F_CP_guar_lo"
)
# Prüfen, ob alle Variablen existieren
missing_vars <- setdiff(fiscal_vars, names(df_bin))
if (length(missing_vars) > 0) {
stop(
paste(
"Diese Variablen fehlen in df_bin:",
paste(missing_vars, collapse = ", ")
)
)
}
# Summen pro Land über das ganze Sample
fiscal_sums_by_country <- df_bin %>%
group_by(Country) %>%
summarise(
across(
all_of(fiscal_vars),
~ sum(.x, na.rm = TRUE)
),
.groups = "drop"
) %>%
arrange(Country)
# Saubere Namen für die Tabelle
fiscal_sums_table <- fiscal_sums_by_country %>%
rename(
`Country` = Country,
`Capacity Preservation` = F_CP,
`Demand Injection` = F_DI,
`Health` = F_H,
`Loans` = F_CP_loans_mid,
`Guarantees` = F_CP_guar_lo
)
# LaTeX-Tabelle erzeugen
latex_fiscal_table <- fiscal_sums_table %>%
mutate(
across(
-Country,
~ round(.x, 2)
)
) %>%
kable(
format = "latex",
booktabs = TRUE,
caption = "Fiscal Policy Sums by Country",
label = "tab:fiscal_sums_country",
align = c("l", rep("r", 5)),
digits = 2
) %>%
kable_styling(
latex_options = c("hold_position", "scale_down"),
font_size = 8
) %>%
footnote(
general = "Notes: Values are summed over the full sample period. CP = capacity preservation, DI = demand injection, H = health-related spending. Loans and guarantees refer to capacity-preservation below-the-line instruments.",
threeparttable = TRUE
)
# Ausgabe in Console / Viewer
latex_fiscal_table
