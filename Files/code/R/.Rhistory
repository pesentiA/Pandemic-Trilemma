y_t_pct ~ y_lag1 + S_mean_tw
+ F_CP_above_stock+ (F_CP_below_flow_adj_lag2^2) + F_CP_below_flow_adj_lag2
+ F_DI_lag1 + F_DI_lag1:S_mean_tw,
data   = pdata_v14,
model  = "within",
effect = "individual"
)
