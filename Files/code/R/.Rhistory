debt_dR_adj ~ y_t_pct + F_CP_above_3 + F_CP_loans_lo +
F_CP_guar_lo + F_DI  | Country,
data = pdataD, subset = ~ t_idx >= 4 & t_idx <= 16)
summary(debt_v15, cluster = ~Country, ssc = ssc(K.adj = TRUE, G.adj = TRUE))
